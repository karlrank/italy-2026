# ───────────────────────────────────────────────────────────────
# Paroolikaitse (VALIKULINE, aga soovitatav)
# ───────────────────────────────────────────────────────────────
# Kui SITE_PASSWORD on seatud, on KOGU sait paroolikaitstud: lehed,
# reisiandmed ja API. Külastaja näeb ilusat sisselogimislehte ja peab
# sisestama jagatud parooli. Ilma selle muutujata on sait avatud.
SITE_PASSWORD=

# ───────────────────────────────────────────────────────────────
# Elav lennustaatus (VALIKULINE)
# ───────────────────────────────────────────────────────────────
# RapidAPI võti AeroDataBox jaoks. Ilma selleta näidatakse lennusektsioonis
# ainult sisestatud infot (number, marsruut), ilma elava staatuseta.
# Hangi tasuta võti: https://rapidapi.com/aedbx-aedbx/api/aerodatabox
FLIGHT_API_KEY=
# Vaikimisi aerodatabox.p.rapidapi.com — muuda ainult vajadusel
# FLIGHT_API_HOST=aerodatabox.p.rapidapi.com

# ───────────────────────────────────────────────────────────────
# Jagatud pakkimisnimekirja salvestus (VALIKULINE)
# ───────────────────────────────────────────────────────────────
# Leht töötab ka ilma nendeta — siis salvestatakse nimekiri brauserisse
# (localStorage, seadmepõhine). Allolevate muutujatega muutub nimekiri
# jagatuks ja sünkroonib mõlema pere kõigi seadmete vahel.
#
# Need lisatakse AUTOMAATSELT, kui ühendad Vercelis projektiga
# KV / Upstash Redise andmebaasi (Storage → Create Database).
# Lokaalseks arenduseks tõmba need: `vercel env pull .env.local`

# Vercel KV (klassikaline nimi)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Upstash for Redis (Marketplace'i integratsiooni nimed — alternatiiv)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
